# Estas variables las crea Vercel automáticamente cuando conectas una base de
# datos KV al proyecto (Storage → Create Database → KV → Connect Project).
# No hace falta rellenarlas a mano salvo que quieras probar en local con:
#   vercel link
#   vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
